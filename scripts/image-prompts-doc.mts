// Usage: node scripts/image-prompts-doc.mts
// Merges docs/image-prompts/*.json into docs/IMAGE-PROMPTS.md (one copyable code block per prompt)
// and docs/image-prompts.html (a page with a copy button on every prompt).
import { readdirSync, readFileSync, writeFileSync } from "node:fs";
import { PLAN } from "../src/content/plan.ts";

interface Entry {
  path: string;
  file: string;
  section: string;
  scene: string;
  prompt: string;
  alt: string;
}

const NEGATIVE =
  "text, letters, numbers, watermark, logo, signature, cartoon, 3D render, illustration, CGI, plastic skin, extra fingers, distorted hands, oversaturated, stock-photo grin, futuristic hologram, robot, glowing brain";

const order = ["home.json", "core-services.json", "strategies.json", "industries.json", "b2b-b2c.json", "capture-qualification.json", "tools-compare.json", "resources.json"];
const files = readdirSync("docs/image-prompts").filter((f) => f.endsWith(".json"));
const sorted = [...order.filter((f) => files.includes(f)), ...files.filter((f) => !order.includes(f))];
const entries: Entry[] = sorted.flatMap((f) => JSON.parse(readFileSync(`docs/image-prompts/${f}`, "utf8")) as Entry[]);

// Checks: every page covered, no duplicate files, scenes or prompts.
const planPaths = new Set(PLAN.map((p) => p.path));
const covered = new Set(entries.map((e) => e.path));
const missing = [...planPaths].filter((p) => !covered.has(p));
const dup = (key: keyof Entry) => {
  const seen = new Map<string, number>();
  for (const e of entries) seen.set(e[key].toLowerCase(), (seen.get(e[key].toLowerCase()) ?? 0) + 1);
  return [...seen].filter(([, n]) => n > 1).map(([v]) => v);
};
const problems = [
  ...missing.map((p) => `missing page: ${p}`),
  ...entries.filter((e) => !planPaths.has(e.path)).map((e) => `unknown page: ${e.path}`),
  ...dup("file").map((v) => `duplicate file: ${v}`),
  ...dup("prompt").map((v) => `duplicate prompt: ${v.slice(0, 60)}`),
  ...dup("scene").map((v) => `duplicate scene: ${v}`),
  ...entries.filter((e) => !e.prompt.includes("no text")).map((e) => `prompt missing suffix: ${e.path}`),
];

const titleOf = new Map(PLAN.map((p) => [p.path, p.title]));
const groupOf = new Map(PLAN.map((p) => [p.path, p.group]));
const label = (g: string) => g.replace(/-/g, " ").replace(/\b\w/g, (c) => c.toUpperCase());

// Markdown
let md = `# Image prompts — LeadGen AI website\n\n`;
md += `${entries.length} images · generated by \`node scripts/image-prompts-doc.mts\` from \`docs/image-prompts/*.json\` · style rules in [IMAGE-PROMPT-BRIEF.md](./IMAGE-PROMPT-BRIEF.md)\n\n`;
md += `**Output for every image:** WebP, 1600×1000 (16:10), saved to \`public\` + the file path shown.\n\n`;
md += `**Negative prompt (use with every image):**\n\n\`\`\`text\n${NEGATIVE}\n\`\`\`\n\n---\n\n`;
let current = "";
entries.forEach((e, i) => {
  const g = e.path === "/" || e.path === "/sitemap" ? "Homepage & sitemap" : label(groupOf.get(e.path) ?? "other");
  if (g !== current) {
    md += `## ${g}\n\n`;
    current = g;
  }
  md += `### ${i + 1}. ${titleOf.get(e.path) ?? e.path} — \`${e.path}\`\n\n`;
  md += `- **Placement:** ${e.section}\n- **Save as:** \`public${e.file}\`\n\n**Prompt**\n\n\`\`\`text\n${e.prompt}\n\`\`\`\n\n**Alt text**\n\n\`\`\`text\n${e.alt}\n\`\`\`\n\n`;
});
writeFileSync("docs/IMAGE-PROMPTS.md", md);

// HTML page with copy buttons
const esc = (s: string) => s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
const cards = entries
  .map((e, i) => {
    const g = e.path === "/" || e.path === "/sitemap" ? "Homepage & sitemap" : label(groupOf.get(e.path) ?? "other");
    return `<article class="card" data-group="${esc(g)}" data-search="${esc(`${titleOf.get(e.path) ?? ""} ${e.path} ${e.scene} ${e.prompt}`.toLowerCase())}">
  <header><span class="num">${i + 1}</span><div><h3>${esc(titleOf.get(e.path) ?? e.path)}</h3><p class="meta"><code>${esc(e.path)}</code> · ${esc(e.section)}</p></div></header>
  <div class="block"><div class="lbl">Prompt <button data-copy="${esc(e.prompt)}">Copy</button></div><p class="prompt">${esc(e.prompt)}</p></div>
  <div class="block"><div class="lbl">Alt text <button data-copy="${esc(e.alt)}">Copy</button></div><p>${esc(e.alt)}</p></div>
  <div class="block small"><div class="lbl">Save as <button data-copy="public${esc(e.file)}">Copy</button></div><code>public${esc(e.file)}</code></div>
</article>`;
  })
  .join("\n");
const groups = [...new Set(entries.map((e) => (e.path === "/" || e.path === "/sitemap" ? "Homepage & sitemap" : label(groupOf.get(e.path) ?? "other"))))];
const html = `<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>Image Prompts</title>
<style>
:root{--bg:#f8f9fc;--surface:#fff;--ink:#0f1222;--soft:#3d4759;--muted:#6b7280;--line:#e4e6f0;--brand:#4f46e5;--brand-soft:#eef0ff}
@media (prefers-color-scheme: dark){:root:not([data-theme="light"]){--bg:#0a0b0f;--surface:#13151d;--ink:#f4f5fb;--soft:#cbd5e1;--muted:#8a92a6;--line:#242836;--brand:#a5b4fc;--brand-soft:rgb(99 102 241/.16)}}
:root[data-theme="dark"]{--bg:#0a0b0f;--surface:#13151d;--ink:#f4f5fb;--soft:#cbd5e1;--muted:#8a92a6;--line:#242836;--brand:#a5b4fc;--brand-soft:rgb(99 102 241/.16)}
*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink);font:15px/1.6 system-ui,-apple-system,"Segoe UI",sans-serif}
.wrap{max-width:60rem;margin:0 auto;padding:32px 16px 80px}h1{margin:0;font-size:28px}.sub{color:var(--muted);margin:6px 0 20px}
.neg,.card{background:var(--surface);border:1px solid var(--line);border-radius:14px;padding:16px 18px}
.bar{position:sticky;top:0;z-index:2;background:var(--bg);padding:12px 0;display:flex;flex-wrap:wrap;gap:8px;align-items:center}
input,select{font:inherit;padding:9px 12px;border:1px solid var(--line);border-radius:10px;background:var(--surface);color:var(--ink)}input{flex:1;min-width:200px}
.count{color:var(--muted);font-size:13px}.list{display:grid;gap:14px;margin-top:8px}
.card header{display:flex;gap:12px;align-items:flex-start}.num{min-width:34px;height:34px;display:grid;place-items:center;border-radius:9px;background:var(--brand-soft);color:var(--brand);font-weight:700;font-size:13px}
h3{margin:0;font-size:16px}.meta{margin:2px 0 0;color:var(--muted);font-size:13px}.block{margin-top:12px}.block p{margin:4px 0 0;color:var(--soft)}
.prompt{background:var(--bg);border:1px solid var(--line);border-radius:10px;padding:10px 12px}
.lbl{display:flex;justify-content:space-between;align-items:center;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.05em;color:var(--muted)}
button{font:inherit;font-size:12px;font-weight:600;text-transform:none;letter-spacing:0;cursor:pointer;border:1px solid var(--line);background:var(--surface);color:var(--brand);border-radius:8px;padding:4px 10px}
button.done{background:var(--brand);color:#fff;border-color:var(--brand)}code{font-size:13px;word-break:break-all}.small code{color:var(--soft)}
</style></head><body><div class="wrap">
<h1>Image prompts</h1><p class="sub">${entries.length} prompts for the LeadGen AI website, one per image position. Output: WebP, 1600×1000 (16:10).</p>
<div class="neg"><div class="lbl">Negative prompt, use with every image <button data-copy="${esc(NEGATIVE)}">Copy</button></div><p>${esc(NEGATIVE)}</p></div>
<div class="bar"><input id="q" placeholder="Search page, path or scene…" aria-label="Search prompts"><select id="g" aria-label="Filter by group"><option value="">All groups</option>${groups.map((g) => `<option>${esc(g)}</option>`).join("")}</select><span class="count" id="c"></span></div>
<div class="list" id="list">
${cards}
</div></div>
<script>
const cards=[...document.querySelectorAll('.card')],q=document.getElementById('q'),g=document.getElementById('g'),c=document.getElementById('c');
function f(){const t=q.value.trim().toLowerCase(),gr=g.value;let n=0;for(const el of cards){const ok=(!t||el.dataset.search.includes(t))&&(!gr||el.dataset.group===gr);el.style.display=ok?'':'none';if(ok)n++}c.textContent=n+' shown'}
q.oninput=f;g.onchange=f;f();
document.addEventListener('click',async e=>{const b=e.target.closest('button[data-copy]');if(!b)return;const v=b.dataset.copy;
try{await navigator.clipboard.writeText(v)}catch{const ta=document.createElement('textarea');ta.value=v;document.body.appendChild(ta);ta.select();document.execCommand('copy');ta.remove()}
const o=b.textContent;b.textContent='Copied';b.classList.add('done');setTimeout(()=>{b.textContent=o;b.classList.remove('done')},1400)});
</script></body></html>`;
writeFileSync("docs/image-prompts.html", html);

console.log(`${entries.length} prompts written to docs/IMAGE-PROMPTS.md and docs/image-prompts.html`);
console.log(problems.length ? `${problems.length} problem(s):\n${problems.join("\n")}` : "checks: all 300 pages covered, no duplicates");
